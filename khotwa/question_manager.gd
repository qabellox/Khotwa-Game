func get_random_question() -> Dictionary:
	if _questions.is_empty():
		return {"q": "?", "options": [], "correct": 0}
	var i: = _last_index
	while i == _last_index and _questions.size() > 1:
		i = randi() % _questions.size()
	_last_index = i
	_current = _questions[i]
	return _current



func current_question() -> Dictionary:
	return _current
